rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Identity helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Bootstrap owner. This account is always superadmin even if its
    // users/{uid} document is missing or tampered with.
    // Must stay in sync with DEFAULT_SUPER_ADMINS in src/config/admins.ts.
    function isEmailSuperAdmin() {
      return isAuthenticated() &&
             (request.auth.token.email == "ramyradad10@gmail.com" ||
              request.auth.token.email == "ramyradad@gmail.com");
    }


    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    function isSuperAdmin() {
      return isEmailSuperAdmin() || (isAuthenticated() && userRole() == 'superadmin');
    }

    // Full store management (mirrors ROLE_PERMISSIONS.admin in src/config/roles.ts)
    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && userRole() == 'admin');
    }

    // Catalog-only staff (mirrors ROLE_PERMISSIONS.editor)
    function isEditor() {
      return isAdmin() || (isAuthenticated() && userRole() == 'editor');
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ---------- Validators ----------
    function isValidUser(data) {
      return hasOnlyAllowedFields([
               'uid', 'email', 'displayName', 'photoURL', 'role',
               'createdAt', 'updatedAt', 'lastLoginAt'
             ]) &&
             data.uid is string && data.uid.size() > 0 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             data.role in ['user', 'editor', 'admin', 'superadmin'] &&
             data.createdAt is string;
    }

    function isValidPerfume(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price > 0 &&
             data.category in ['men', 'women', 'unisex'] &&
             data.inspiredBy is string && data.inspiredBy.size() < 100 &&
             data.stock is number && data.stock >= 0 &&
             (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() < 100)) &&
             (!('brand' in data) || (data.brand is string && data.brand.size() < 100)) &&
             (!('concentration' in data) || (data.concentration is string && data.concentration.size() < 50)) &&
             (!('sku' in data) || (data.sku is string && data.sku.size() < 60)) &&
             (!('compareAtPrice' in data) || data.compareAtPrice == null ||
               (data.compareAtPrice is number && data.compareAtPrice >= 0)) &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() < 2000)) &&
             (!('metaTitle' in data) || (data.metaTitle is string && data.metaTitle.size() < 200)) &&
             (!('metaDescription' in data) || (data.metaDescription is string && data.metaDescription.size() < 400)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 500)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('notes' in data) || (data.notes is map)) &&
             (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 10)) &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('isNew' in data) || data.isNew is bool) &&
             (!('isBestSeller' in data) || data.isBestSeller is bool) &&
             (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
             (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0)) &&
             (!('id' in data) || data.id is string) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Orders are placed through WhatsApp checkout and guests are allowed, so
    // creation is open but tightly validated. Reading stays restricted.
    function isValidOrder(data) {
      return data.items is list && data.items.size() > 0 && data.items.size() < 100 &&
             data.totalAmount is number && data.totalAmount > 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.paymentMethod in ['whatsapp', 'cod', 'card'] &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 120 &&
             data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() < 25 &&
             data.createdAt is string &&
             (!('userId' in data) || (data.userId is string && data.userId.size() < 60)) &&
             (!('isGuest' in data) || data.isGuest is bool) &&
             (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() < 40)) &&
             (!('shippingFee' in data) || (data.shippingFee is number && data.shippingFee >= 0)) &&
             (!('paymentStatus' in data) || data.paymentStatus in ['pending', 'paid', 'failed', 'refunded']) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 1000)) &&
             (!('address' in data) || (data.address is string && data.address.size() < 500)) &&
             (!('shippingAddress' in data) || (data.shippingAddress is string && data.shippingAddress.size() < 500));
    }

    // ---------- Collections ----------
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      // A user may only ever create their own document with the 'user' role.
      allow create: if isValidUser(request.resource.data) && (
                      isSuperAdmin() ||
                      (isOwner(userId) && request.resource.data.role == 'user')
                    );

      // Role escalation is restricted to superadmins. Everyone else can edit
      // their own profile as long as the role stays untouched.
      allow update: if isValidUser(request.resource.data) && (
                      isSuperAdmin() ||
                      (isAdmin() && request.resource.data.role in ['user', 'editor'] &&
                        resource.data.role in ['user', 'editor']) ||
                      (isOwner(userId) && request.resource.data.role == resource.data.role)
                    );

      allow delete: if isSuperAdmin();
    }

    // Role reservations claimed on first login, keyed by lowercased email.
    match /roleInvites/{email} {
      allow read: if isAdmin() ||
                     (isAuthenticated() && request.auth.token.email != null &&
                       request.auth.token.email.lower() == email);
      allow create, update: if
                     (isSuperAdmin() && request.resource.data.role in ['user', 'editor', 'admin', 'superadmin']) ||
                     (isAdmin() && request.resource.data.role in ['user', 'editor']);

      allow delete: if isAdmin();
    }

    match /perfumes/{perfumeId} {
      allow read: if true; // Public storefront
      allow create: if isEditor() && isValidPerfume(request.resource.data);
      allow update: if isEditor() && isValidPerfume(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (resource != null && resource.data.userId != 'guest' && isOwner(resource.data.userId));
      allow create: if isValidOrder(request.resource.data) &&
                       request.resource.data.status == 'pending' &&
                       (!('userId' in request.resource.data) ||
                         request.resource.data.userId == 'guest' ||
                         isOwner(request.resource.data.userId));
      allow update: if isValidOrder(request.resource.data) && (
                      isAdmin() ||
                      (resource != null && isOwner(resource.data.userId) &&
                        request.resource.data.status == 'cancelled' &&
                        resource.data.status == 'pending')
                    );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.rating is number &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() <= 1000;
      allow update: if isAdmin();
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /gift_sets/{giftSetId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /policies/{policyId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /purchase_orders/{purchaseOrderId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /crm_interactions/{interactionId} {
      allow read, write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /back_in_stock_requests/{requestId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['perfumeId', 'contact', 'createdAt']) &&
                       request.resource.data.contact is string && request.resource.data.contact.size() > 0 &&
                       request.resource.data.perfumeId is string;
    }

    match /size_mappings/{mappingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}


